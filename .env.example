# VibeShift AI - Environment Configuration Template
# Copy this file to .env and fill in your real values. NEVER commit .env to Git.
#
# Server-side Gemini API key — keep this on the server only, never expose to the browser:
LLM_API_KEY=your_gemini_api_key_here
# Backend server port (defaults to 5000 to match frontend API proxy)
PORT=5000
# Optional model override (defaults to gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash
# Optional mock mode for cost-free testing (no real API key needed)
# MOCK_LLM=true
