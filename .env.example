# VibeShift AI - Environment Configuration Template
# Server-side Gemini API key (never expose to client or commit to git):
LLM_API_KEY=
# Backend server port (defaults to 5000 to match frontend API proxy)
PORT=5000
# Optional model override (defaults to gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash
# Optional mock mode for cost-free testing
# MOCK_LLM=true
